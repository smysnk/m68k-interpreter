{
  "name": "m68k-interpreter-monorepo",
  "private": true,
  "packageManager": "yarn@4.17.1",
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "./scripts/mono-helper.sh env yarn dev:raw",
    "dev:raw": "yarn workspace @m68k/ide dev --host ${WEB_HOST:-127.0.0.1} --port ${WEB_PORT:-3000}",
    "build": "yarn workspaces foreach -Apt --exclude m68k-interpreter-monorepo run build",
    "build:interpreter": "yarn workspace @m68k/interpreter build",
    "build:ide": "yarn workspace @m68k/ide build",
    "build:smysnk": "yarn workspace @m68k/ide build:smysnk",
    "build:pages": "yarn workspace @m68k/ide build:pages",
    "capture:readme-demo": "node ./scripts/capture-readme-demo.mjs",
    "readme:videos": "node ./scripts/upload-readme-videos.mjs",
    "preview": "yarn workspace @m68k/ide preview --host ${WEB_HOST:-127.0.0.1} --port ${WEB_PORT:-3000}",
    "preview:e2e": "yarn build:ide && yarn workspace @m68k/ide preview --host ${WEB_HOST:-127.0.0.1} --port ${WEB_PORT:-4173}",
    "test": "yarn test:station",
    "test:metadata": "node --test ./scripts/test-station/*.test.mjs",
    "test:station": "yarn test:metadata && node ./scripts/test-station/run-cli.mjs run --config ./test-station.config.mjs --no-coverage",
    "test:station:coverage": "yarn test:metadata && node ./scripts/test-station/run-cli.mjs run --config ./test-station.config.mjs --coverage",
    "test:benchmark:station": "yarn test:metadata && node ./scripts/test-station/run-cli.mjs run --config ./test-station.config.mjs --no-coverage --package benchmark",
    "test:coverage": "yarn test:station:coverage",
    "test:raw": "yarn test:metadata && yarn test:packages && yarn test:integration && yarn test:e2e",
    "test:packages": "yarn workspaces foreach -Apt --exclude m68k-interpreter-monorepo run test",
    "test:interpreter": "yarn workspace @m68k/interpreter test",
    "test:ide": "yarn workspace @m68k/ide test",
    "test:retro-display:contract": "yarn workspace @m68k/ide test --run src/components/retro/RetroScreenUpstreamContract.test.tsx src/components/retro/TouchRetroScreen.test.tsx src/components/Terminal.test.tsx",
    "test:performance": "vitest run --config vitest.performance.config.ts tests/benchmarks/**/*.test.ts --execArgv=--expose-gc",
    "test:performance:test-station": "tsx ./tests/benchmarks/emitEngineBenchmarkSuite.ts",
    "test:performance:nibbles-intro": "vitest run --config vitest.performance.config.ts tests/benchmarks/nibblesIntroProfiling.test.ts --execArgv=--expose-gc",
    "test:performance:nibbles-intro:test-station": "tsx ./tests/benchmarks/emitNibblesIntroBenchmarkSuite.ts",
    "test:performance:multimedia:test-station": "tsx ./tests/benchmarks/emitEasy68kMultimediaBenchmarkSuite.ts",
    "test:performance:browser:test-station": "tsx ./tests/benchmarks/emitNibblesBrowserBenchmarkSuite.ts",
    "test:performance:debugger:test-station": "tsx ./tests/benchmarks/emitDebuggerBenchmarkSuite.ts",
    "test:performance:debugger-browser:test-station": "tsx ./tests/benchmarks/emitDebuggerBrowserBenchmarkSuite.ts",
    "profile:ide-runtime": "tsx ./scripts/profile-ide-runtime-summary.ts",
    "profile:ide-runtime:json": "tsx ./scripts/profile-ide-runtime-summary.ts --json",
    "profile:m68000:final": "tsx ./scripts/capture-m68000-performance.ts",
    "profile:m68000:compare": "tsx ./scripts/compare-m68000-performance.ts",
    "profile:cpu-machine": "tsx ./scripts/capture-cpu-machine-profile.ts",
    "profile:cpu-machine:compare": "tsx ./scripts/compare-cpu-machine-profiles.ts",
    "profile:ide-runtime:compare": "tsx ./scripts/compare-ide-runtime-profiles.ts",
    "profile:panel-drag": "tsx ./scripts/profile-panel-drag-summary.ts",
    "profile:panel-workspace:compare": "tsx ./scripts/compare-panel-workspace-profiles.ts",
    "profile:panel-workspace:test-station": "tsx ./scripts/emit-panel-workspace-profile-suite.ts",
    "generate:isa-report": "tsx ./scripts/generate-isa-report.ts",
    "oracles:bootstrap": "node ./scripts/bootstrap-m68k-oracles.mjs",
    "oracles:build": "node ./scripts/build-m68k-oracles.mjs",
    "test:oracles": "yarn oracles:build && vitest run --config vitest.performance.config.ts tests/oracles/**/*.test.ts",
    "test:oracles:mame": "tsx ./scripts/audit-mame-corpus.ts",
    "test:panel-workspace:performance:station": "node ./scripts/test-station/run-cli.mjs run --config ./test-station.panel-workspace.config.mjs --no-coverage",
    "test:integration": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:e2e:shell": "playwright test --config playwright.config.ts tests/e2e/ide-shell.spec.ts",
    "test:e2e:headed": "playwright test --config playwright.config.ts --headed",
    "test:e2e:install": "playwright install chromium",
    "bench:engines": "vitest bench --config vitest.performance.config.ts tests/benchmarks/**/*.bench.ts --run --execArgv=--expose-gc",
    "bench:engines:json": "vitest bench --config vitest.performance.config.ts tests/benchmarks/**/*.bench.ts --run --execArgv=--expose-gc --outputJson ./engine-benchmarks.json",
    "type-check": "yarn workspaces foreach -Apt --exclude m68k-interpreter-monorepo run type-check",
    "type-check:interpreter": "yarn workspace @m68k/interpreter type-check",
    "type-check:ide": "yarn workspace @m68k/ide type-check",
    "lint": "eslint \"packages/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"packages/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" --fix",
    "format": "prettier --write \"packages/**/*.{ts,tsx,json,css,md}\" \"tests/**/*.{ts,tsx}\""
  },
  "devDependencies": {
    "@eslint/compat": "2.1.0",
    "@eslint/js": "10.0.1",
    "@m68k/ide": "workspace:*",
    "@m68k/interpreter": "workspace:*",
    "@playwright/test": "1.61.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "8.64.0",
    "@typescript-eslint/parser": "8.64.0",
    "@vitest/coverage-v8": "4.1.10",
    "dotenv": "17.4.2",
    "eslint": "10.7.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.7.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.5",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "overrides": {
    "@rollup/plugin-terser": "^1.0.0"
  }
}
