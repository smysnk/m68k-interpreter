{
  "name": "@m68k/ide",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "React IDE for the M68K interpreter",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "dependencies": {
    "@codemirror/language": "6.12.4",
    "@codemirror/legacy-modes": "6.5.3",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.6",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fortawesome/fontawesome-svg-core": "7.3.1",
    "@fortawesome/free-solid-svg-icons": "7.3.1",
    "@fortawesome/react-fontawesome": "3.4.0",
    "@lezer/highlight": "^1.2.3",
    "@m68k/interpreter": "workspace:*",
    "@reduxjs/toolkit": "2.12.0",
    "@uiw/codemirror-themes": "4.25.11",
    "@uiw/react-codemirror": "4.25.11",
    "@vercel/analytics": "^2.0.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-redux": "9.3.0",
    "react-resizable-panels": "4.12.2",
    "react-retro-display-tty-ansi-ascii": "0.1.189",
    "styled-components": "6.4.4"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "build:smysnk": "tsc -p tsconfig.json --noEmit && VITE_DEPLOY_TARGET=smysnk vite build && node ./build/renderStaticPages.mjs",
    "build:pages": "tsc -p tsconfig.json --noEmit && node ./build/renderGithubPagesRedirect.mjs",
    "preview": "vite preview",
    "test": "../../node_modules/.bin/vitest run --config vitest.config.ts && node --test ./build/renderStaticPages.test.mjs",
    "type-check": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "vite": "^8.1.5",
    "vitest": "4.1.10"
  }
}
